# Donki Chat Environment Configuration
# Copy this file to .env and fill in the values

# ===========================================
# REQUIRED
# ===========================================

# Password hash for login (generate with: npx bcrypt-cli hash "your-password")
PASSWORD_HASH=

# Session secret (random 32+ characters)
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# ===========================================
# OPTIONAL
# ===========================================

# OpenClaw/Claude API
OPENCLAW_API_URL=http://host.docker.internal:8080
OPENCLAW_API_KEY=

# Claude model to use
CLAUDE_MODEL=claude-sonnet-4-20250514

# Maximum tokens for responses
MAX_TOKENS=4096

# Database path (relative to app root)
DATABASE_PATH=./data/chat.db

# Upload directory (relative to app root)
UPLOAD_DIR=./data/uploads

# Maximum file upload size in bytes (default: 10MB)
MAX_FILE_SIZE=10485760

# Node environment
NODE_ENV=production
